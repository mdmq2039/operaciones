# Copia este archivo como .env y completa con tus credenciales reales.
# NUNCA subas el .env real al repositorio (está en .gitignore).

# Cadena de conexión de Supabase (Connection string -> URI).
# Reemplaza [YOUR-PASSWORD] por tu contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.XXXXXXXXXXXX:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres
